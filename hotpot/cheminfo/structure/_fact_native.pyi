"""Private compiled ingress and the sole numeric Atom installer."""

from typing import Any, Iterable

from ._mutation import _AtomFactUpdate

def _configure(declarations: dict[str, Any]) -> None: ...
def _install_atom_dispatch(atom_type: type, eager_setter: Any, sparse_commit: Any,
                           foreign_error: type, detached_error: type) -> None: ...
def _commit_atom_scalar(atom: Any, field_index: int, value: Any, *,
                        producer: int, present: bool = True) -> None: ...
def _commit_atom_facts(mol: Any, update: _AtomFactUpdate) -> None: ...
def _commit_atom_fields(atom: Any, columns: dict[str, Any], *,
                        producer: int, present: bool = True) -> None: ...
def _commit_atom_columns(mol: Any, atoms: tuple[Any, ...] | None,
                         columns: dict[str, Any]) -> _AtomFactUpdate: ...
def _write_prepared(table: Any, selection: Any, prepared: Any,
                     transaction: Any = None) -> None: ...
def _restore_write(state: Any) -> None: ...
def _capture_status(table: Any, rows: Iterable[int], groups: Iterable[int]) -> Any: ...
def _update_dependency_seeds(mol: Any, groups: tuple[int, ...],
                              uids: tuple[int, ...], present: bool) -> None: ...
def _clear_dependency_seeds(mol: Any, group: int, rows: Iterable[int]) -> None: ...
def _scalar_value(value: Any) -> float: ...
def _normalize_atom_scalar(source: Any, row: int, atom_uid: int, field: str,
                            value: Any, producer: int, present: bool) -> _AtomFactUpdate: ...
def _normalize_atom_facts(source: Any, rows: Iterable[int], uids: Iterable[int],
                           columns: dict[str, Any]) -> _AtomFactUpdate: ...
def _normalize_atom_fields(source: Any, rows: Iterable[int], uids: Iterable[int],
                            columns: dict[str, Any], producer: int,
                            present: bool) -> _AtomFactUpdate: ...
