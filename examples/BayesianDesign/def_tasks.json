      },
      "primary_metric": {
        "logK": "r2"
      }
    },
    "GibbsBeta": {
      "options": {
        "with_xyz": false,
        "with_sol": true,
        "with_med": true
      },
      "feature_extractors": {
        "logK": "mol"
      },
      "predictors": {
        "logK": "num"
      },
      "target_getters": {
        "logK": {"data_item": "y"}
      },
      "loss_fn": {
        "logK": "mse"
      },
      "primary_metric": {
        "logK": "r2"
      }
    },
    "GibbsBeta_CB": {
      "options": {
        "with_xyz": false,
        "with_sol": true,
        "with_med": true
      },
      "feature_extractors": {
        "logK": "mol"
      },
      "predictors": {
        "logK": "num"
      },
      "target_getters": {
        "logK": {"data_item": "y"}
      },
      "loss_fn": {
        "logK": "mse"
      },
      "primary_metric": {
