      "to": "attempt",
      "label": "无穿环但 basic gate 失败",
      "role": "return"
    },
    {
      "from": "candidate_gate",
      "to": "candidate_refine",
      "label": "无穿环且 basic gate 通过",
      "role": "main"
    },
    {
      "from": "candidate_refine",
      "to": "attempt",
      "label": "候选尚未收齐",
      "role": "return"
    },
    {
      "from": "candidate_refine",
      "to": "full_optimize",
      "label": "精修首个通过",
      "role": "main"
    },
    {
      "from": "full_optimize",
      "to": "commit",
      "label": "至少一个通过帧",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "from": "attempt",
      "to": "failure",
      "label": "max_attempts 耗尽",
      "role": "error",
      "variant": "security"
    },
    {
      "from": "full_optimize",
      "to": "failure",
      "label": "无合格帧",
      "role": "error",
      "variant": "security"
    }
  ]
