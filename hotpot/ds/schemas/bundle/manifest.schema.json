{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotpot.invalid/schemas/ds/bundle/manifest.schema.json",
  "title": "Hotpot Dataset Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ds_name",
    "release_id",
    "version",
    "title",
    "description",
    "license",
    "access_policy",
    "provenance",
    "core_labels",
    "core_info",
    "intake",
    "identity_schema",
    "required_structure_roles"
  ],
  "properties": {
    "schema": {"const": "hotpot-ds-bundle/current"},
    "ds_name": {"$ref": "#/$defs/nonempty"},
    "dataset_id": {"$ref": "#/$defs/nonempty"},
    "release_id": {"$ref": "#/$defs/nonempty"},
    "release_serial": {"type": "integer", "minimum": 1, "maximum": 999},
    "version": {"$ref": "#/$defs/nonempty"},
    "title": {"$ref": "#/$defs/nonempty"},
    "description": {"$ref": "#/$defs/nonempty"},
    "license": {"$ref": "#/$defs/nonempty"},
    "access_policy": {"$ref": "#/$defs/nonempty"},
    "provenance": {"type": "object"},
    "core_labels": {"$ref": "#/$defs/uniqueStrings"},
    "core_info": {"$ref": "#/$defs/uniqueStrings"},
    "identity_schema": {"$ref": "#/$defs/identitySchema"},
    "property_definitions": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/nonempty"},
      "additionalProperties": {"$ref": "#/$defs/propertyDefinition"}
    },
    "property_comparators": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/nonempty"},
      "additionalProperties": {"$ref": "#/$defs/propertyComparator"}
    },
    "control_assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/controlAsset"},
      "uniqueItems": true
    },
    "required_structure_roles": {
      "$ref": "#/$defs/uniqueStrings",
      "description": "Required scientific Structure roles. The reserved value '*' requires at least one active Structure with a present, hash-valid, parse-valid representation, regardless of role. Every named role remains independently required."
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "path"],
      "properties": {
        "format": {"enum": ["jsonl", "sqlite"]},
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        }
      }
    }
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "uniqueStrings": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonempty"},
      "uniqueItems": true
    },
    "identitySchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components"],
      "properties": {
        "components": {
          "type": "array",
          "items": {"$ref": "#/$defs/identityComponent"}
        }
      }
    },
    "identityComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "path"],
      "allOf": [
        {
          "if": {"required": ["normalizer"], "properties": {"normalizer": {"enum": ["text", "casefold"]}}},
          "then": {"properties": {"value_kind": {"const": "text"}}}
        },
        {
          "if": {"required": ["normalizer"], "properties": {"normalizer": {"const": "number"}}},
          "then": {"properties": {"value_kind": {"const": "number"}}}
        },
        {
          "if": {"required": ["normalizer"], "properties": {"normalizer": {"const": "boolean"}}},
          "then": {"properties": {"value_kind": {"const": "boolean"}}}
        },
        {
          "if": {"required": ["normalizer"], "properties": {"normalizer": {"const": "set"}}},
          "then": {"properties": {"value_kind": {"const": "set"}}}
        },
        {
          "if": {"required": ["normalizer"], "properties": {"normalizer": {"const": "json"}}},
          "then": {"properties": {"value_kind": {"const": "json"}}}
        },
        {
          "if": {"required": ["value_kind"], "properties": {"value_kind": {"enum": ["number", "boolean", "set", "json"]}}},
          "then": {"required": ["normalizer"]}
        }
      ],
      "properties": {
        "key": {"$ref": "#/$defs/nonempty"},
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)*$"
        },
        "required": {"type": "boolean"},
        "value_kind": {"enum": ["text", "number", "boolean", "set", "json"]},
        "normalizer": {"enum": ["text", "casefold", "number", "boolean", "set", "json"]},
        "comparator": {"const": "exact"},
        "structure_role": {"$ref": "#/$defs/nonempty"},
        "mismatch_is_decisive": {"type": "boolean"},
        "implementation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "protocol_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "propertyDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["integer", "real", "category", "text", "boolean", "json"]
        },
        "schema_version": {"$ref": "#/$defs/nonempty"},
        "unit": {
          "oneOf": [
            {"$ref": "#/$defs/nonempty"},
            {"type": "null"}
          ]
        },
        "allowed_values": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "normalizer": {"enum": ["identity", "casefold"]},
        "context_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(subject|site|phase|participants|branch|conditions(?:\\.[^.]+)*|method(?:\\.[^.]+)*)$"
          }
        }
      }
    },
    "propertyComparator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["exact", "numeric", "categorical"]},
        "absolute_tolerance": {"type": "number", "minimum": 0},
        "relative_tolerance": {"type": "number", "minimum": 0},
        "use_uncertainty": {"type": "boolean"},
        "unit_conversions": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/nonempty"},
          "additionalProperties": {"$ref": "#/$defs/unitConversion"}
        }
      }
    },
    "controlAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "name", "path", "sha256", "size"],
      "properties": {
        "category": {"$ref": "#/$defs/nonempty"},
        "name": {"$ref": "#/$defs/nonempty"},
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "unitConversion": {
      "oneOf": [
        {"type": "number"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scale": {"type": "number"},
            "offset": {"type": "number"}
          }
        }
      ]
    }
  }
}
