    "viewBox": [1200, 780]
  },
  "lanes": [
    { "id": "control", "label": "准备与候选控制" },
    { "id": "optimization", "label": "构筑与优化" },
    { "id": "gate_repair", "label": "几何门控与临时开环" },
    { "id": "refinement", "label": "候选精修与完整体系" },
    { "id": "exit", "label": "提交或失败", "variant": "exception" }
  ],
  "phases": [
