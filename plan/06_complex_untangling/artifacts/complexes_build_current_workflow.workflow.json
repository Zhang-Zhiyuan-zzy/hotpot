      "type": "backend",
      "label": "complexes_build",
      "sublabel": "建立 working_mol"
    },
    {
      "id": "proxy_setup",
      "lane": "control",
      "col": 1,
      "width": 148,
      "type": "messagebus",
      "label": "隐藏配位键",
      "sublabel": "建立 ligand proxies"
