{
  "cli_commands": {
    "cbond": {
      "help": "Build metal-ligand coordination bonds with the CBond model",
      "module": "hotpot.cheminfo.AImodels.cbond.cli"
    },
    "convert": {
      "help": "Convert molecule file from one format to another",
      "module": null
    },
    "ds": {
      "help": "Assess, store, and query governed scientific datasets",
      "module": "hotpot.ds.cli"
    },
    "ff": {
      "help": "Build and optimize molecular geometries with force fields",
      "module": "hotpot.cheminfo.forcefields.cli"
    },
    "mca": {
      "help": "Predict atom-resolved methyl cation affinity (MCA)",
      "module": "hotpot.cheminfo.AImodels.mca.cli"
    },
    "ml_train": {
      "help": "A standard workflow to train Machine learning models",
      "module": "hotpot.main.ml_train"
    },
    "models": {
      "help": "Install and verify external inference models",
      "module": "hotpot.cheminfo.AImodels.artifacts.cli"
    },
    "optimize": {
      "help": "Perform parameters optimization",
      "module": "hotpot.main.optimize"
    },
    "run": {
      "help": "Run a controlled sequence of molecular calculation stages",
      "module": "hotpot.pipeline.cli"
    },
    "xtb": {
      "help": "Run an independent GFN-FF or GFN-xTB calculation",
      "module": "hotpot.plugins.xtb.cli"
    }
  },
