  "settled_root_direction": [
    "One complete ordered authoritative Bond collection and private operation-local exclusions.",
    "Connected retirement of the exact eight Decision6 methods; no aliases/public selector.",
    "Complete clear_constraints only at connected full-Bond cutover; constraint slice remains accepted.",
    "Native masks are operation/session/trajectory observations; ordinary native completion retains factual Bonds.",
    "Preserve approved chemistry/native/model meaning, last finite observations, selected/terminal topology and complete source/UID/rollback attribution."
  ],
  "root_review_dispositions": [
    {
      "id": "HT1",
      "status": "PROPOSED_EXACT_ROUTE_FOR_ACCEPTANCE",
      "choice": "Existing XOR metal-ligand predicate; private selected components and independent projected chemistry/backend inputs; H retains a complete working clone with original handles/UIDs, adds one independent H projection, then assembles original full Bond order followed by H using existing source/currentness/rollback.",
      "scientific_change": "No numerical rule/backend/model change intended; characterize same-input differences and do not normalize known H/isotope problems."
    },
    {
      "id": "HT2",
      "status": "ROOT_SEMANTIC_DIRECTION_SELECTED_EXACT_OBSERVABLE_DISPOSITION_PENDING_ACCEPTANCE",
      "choice": "Exported apply_native_selected_structure keeps signature/None return and commits validated selected coordinates only; valid zero/mixed masks do not persist hidden/deleted membership or reorder Bonds; result/session/trajectory preserves masks.",
      "observable_change": "Synthetic generic-adapter tests currently demand persistent zero/mixed hidden membership; intentionally replace that expectation. Normal native completion and selected/terminal archive distinction retain existing meaning."
    },
    {
      "id": "HT3",
      "status": "PROPOSED_REQUIRES_ROOT_DISPOSITION",
      "choice": "Remove private bond_partitions and make existing MoleculeRecord keyword-only, with tagged version2 private pickle reducer/constructor validation; explicitly reject old positional record/Molecule/Bond pickle loading rather than silently reinterpret it.",
      "limits": "Freeze6d1ea01 previous-current fixtures before edits; no arbitrary historical-asset audit/compatibility claim, no bridge, Decision10 later core-path policy remains open."
    },
    {
      "id": "HT4",
      "status": "PROPOSED_REQUIRES_ROOT_DISPOSITION",
      "choice": "Apply existing simple active-graph uniqueness to the complete collection: reject duplicate unordered endpoint pairs including old cross-partition duplicates atomically; no winner selection/dedup/multigraph expansion.",
      "observable_change": "Existing private builder/overlapping hidden fixture behavior is intentionally retired; keep valid constraint/view science and add rejection coverage."
    },
    {
      "id": "HT5",
      "status": "PROPOSED_CONCRETE_RESERVED_BUDGET_FOR_ACCEPTANCE",
      "choice": "Consume N04 as one private immutable _TopologySelection(source,atom_uids,bond_mask) class; no generic DTO, public symbol, Protocol/TypedDict/Enum/exception/native ABI addition. Update owning budget ledger before/with implementation release."
    }
  ],
